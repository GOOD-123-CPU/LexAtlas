# ============================================
# LexAtlas 环境变量配置模板
# 复制为 .env（docker compose 自动读取）或注入系统环境变量
# 切勿将真实 .env 提交到版本库
# ============================================

# ---------- LLM 服务（必填） ----------
# 阿里云百炼平台 https://bailian.console.aliyun.com 申请
# 兼容任何 OpenAI 格式接口：DeepSeek / 通义千问 / Ollama 等
BAILIAN_API_KEY=sk-your-api-key-here
# 可选：切换其他 OpenAI 兼容服务
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---------- 安全（生产必填） ----------
# JWT 签名密钥，至少 48 字符随机字符串
# 生成方式: openssl rand -base64 48
JWT_SECRET=please-change-this-to-a-long-random-secret-string-min-48chars
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# 首次启动时创建管理员；密码至少 12 位。创建后可从环境中移除这两项。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# 仅本地演示可开启；验证码会写入后端日志，生产环境必须保持 false 并接入真实短信服务。
PASSWORD_RESET_DEMO_MODE=false

# ---------- 数据库 ----------
MYSQL_HOST=localhost
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-password
MYSQL_DATABASE=lexatlas

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PASSWORD=

# ---------- 对象存储 MinIO ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=lexatlas

# ---------- 向量数据库 Milvus ----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=legal_knowledge

# ---------- 日志 ----------
# 日志输出目录（logback-spring.xml 读取）
# LOG_PATH=./logs
